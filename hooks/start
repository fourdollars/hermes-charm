#!/bin/bash
# start hook — start or install the Hermes Gateway service
# shellcheck disable=SC1091

source "$(dirname "$0")/common.sh"

status_set maintenance "Starting Hermes Gateway"

AI_PROVIDER=$(config_get ai-provider)
AI_MODEL=$(config_get ai-model)
AI_API_KEY=$(config_get ai-api-key)

# Check minimum config
if [ -z "$AI_PROVIDER" ] || [ -z "$AI_MODEL" ]; then
    status_set blocked "Cannot start: missing AI provider or model"
    exit 0
fi

if [ -z "$AI_API_KEY" ] && [ "$AI_PROVIDER" != "ollama" ]; then
    status_set blocked "Cannot start: missing API key for ${AI_PROVIDER}"
    exit 0
fi

# Install user-level systemd service if not already present
if ! systemctl_user is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
    log "Installing Hermes Gateway systemd user service"
    ensure_linger
    ensure_hermes_dir

    cat > "/tmp/hermes-gateway-start.service" << UNITEOF
[Unit]
Description=Hermes Agent Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${HERMES_HOME}
Environment=HOME=${HERMES_HOME}
Environment=PATH=${HERMES_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/hermes gateway
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
UNITEOF

    install -o "${HERMES_USER}" -g "${HERMES_USER}" -m 644 \
        /tmp/hermes-gateway-start.service "${HERMES_SYSTEMD_DIR}/${SERVICE_NAME}"
    rm -f /tmp/hermes-gateway-start.service

    systemctl_user daemon-reload
    systemctl_user enable "$SERVICE_NAME"
fi

# Start the service
start_service

sleep 2

if is_service_active; then
    log "Hermes Gateway started successfully"
    MSG="Running (${AI_PROVIDER}/${AI_MODEL})"
    if systemctl_user is-active --quiet "$DASHBOARD_SERVICE_NAME" 2>/dev/null; then
        UNIT_IP=$(hostname -I | awk '{print $1}')
        DASHBOARD_PORT=$(config_get dashboard-port)
        MSG="${MSG} | Dashboard: http://${UNIT_IP}:${DASHBOARD_PORT}"
    fi
    status_set active "$MSG"
else
    log "Hermes Gateway failed to start"
    status_set blocked "Service failed to start — check: journalctl --user -u ${SERVICE_NAME}"
fi
