#!/bin/bash
# config-changed hook — generate Hermes config from Juju options
# shellcheck disable=SC1091

source "$(dirname "$0")/common.sh"

# Resolve effective hermes binary and venv based on install method
_INSTALL_METHOD=$(config_get install-method)
if [ "$_INSTALL_METHOD" = "script" ] || [ -f "${HERMES_SCRIPT_VENV}/bin/hermes" ]; then
    HERMES_VENV="${HERMES_SCRIPT_VENV}"
fi
# HERMES_BIN is already the ~/.local/bin/hermes symlink from common.sh

status_set maintenance "Applying configuration"

MANUAL=$(config_get manual)

if [ "$MANUAL" = "true" ] || [ "$MANUAL" = "True" ]; then
    log "Manual mode enabled — skipping config generation"
    if is_service_active; then
        status_set active "Running (manual config)"
    else
        status_set waiting "Manual config mode — configure ~/.hermes/ manually"
    fi
    exit 0
fi

ensure_hermes_dir

# ---- Read config values ----
AI_PROVIDER=$(config_get ai-provider)
AI_MODEL=$(config_get ai-model)
AI_API_KEY=$(config_get ai-api-key)
AI_BASE_URL=$(config_get ai-base-url)

# Normalize provider name to Hermes internal ID
normalize_provider() {
    local p="$1"
    case "$p" in
        github-copilot|copilot|github|github-models) echo "copilot" ;;
        gemini) echo "google" ;;
        hf) echo "huggingface" ;;
        *) echo "$p" ;;
    esac
}
AI_PROVIDER=$(normalize_provider "$AI_PROVIDER")
GATEWAY_PORT=$(config_get gateway-port)
TELEGRAM_TOKEN=$(config_get telegram-bot-token)
DISCORD_TOKEN=$(config_get discord-bot-token)
SLACK_BOT_TOKEN=$(config_get slack-bot-token)
SLACK_APP_TOKEN=$(config_get slack-app-token)
SIGNAL_PHONE=$(config_get signal-phone-number)
LINE_TOKEN=$(config_get line-channel-access-token)
LINE_SECRET=$(config_get line-channel-secret)
# shellcheck disable=SC2034  # used in future dm-policy support
DM_POLICY=$(config_get dm-policy)
LOG_LEVEL=$(config_get log-level)
PERSONALITY=$(config_get personality)
SOUL_MD=$(config_get soul-md)
TERMINAL_BACKEND=$(config_get terminal-backend)
COMPRESSION=$(config_get compression-enabled)
MAX_TURNS=$(config_get max-turns)
ALLOW_ALL=$(config_get gateway-allow-all-users)
HA_URL=$(config_get home-assistant-url)
HA_TOKEN=$(config_get home-assistant-token)
MATRIX_HOMESERVER=$(config_get matrix-homeserver)
MATRIX_USER_ID=$(config_get matrix-user-id)
MATRIX_TOKEN=$(config_get matrix-access-token)
MATTERMOST_URL=$(config_get mattermost-url)
MATTERMOST_TOKEN=$(config_get mattermost-token)
DASHBOARD_USERNAME=$(config_get dashboard-username)
DASHBOARD_PASSWORD=$(config_get dashboard-password)

# ---- Generate config.yaml ----
log "Generating config.yaml"

CONFIG_FILE="${HERMES_DIR}/config.yaml"

{
    echo "# Managed by Juju charm — manual edits will be overwritten on config-changed"

    # Model (must be dict format for provider detection)
    if [ -n "$AI_PROVIDER" ] && [ -n "$AI_MODEL" ]; then
        echo "model:"
        echo "  provider: ${AI_PROVIDER}"
        echo "  default: ${AI_MODEL}"
    elif [ -n "$AI_MODEL" ]; then
        echo "model:"
        echo "  default: ${AI_MODEL}"
    fi

    # Max turns
    echo "max_turns: ${MAX_TURNS}"

    # Personality
    if [ -n "$PERSONALITY" ]; then
        echo "personality: ${PERSONALITY}"
    fi

    # Terminal
    echo ""
    echo "terminal:"
    echo "  backend: ${TERMINAL_BACKEND}"

    # Compression
    echo ""
    echo "compression:"
    if [ "$COMPRESSION" = "true" ] || [ "$COMPRESSION" = "True" ]; then
        echo "  enabled: true"
    else
        echo "  enabled: false"
    fi

    # Gateway
    echo ""
    echo "gateway:"
    echo "  port: ${GATEWAY_PORT}"

    # Logging
    echo ""
    echo "logging:"
    echo "  level: ${LOG_LEVEL}"

    # Fallback models (comma-separated provider/model list)
    AI_FALLBACK=$(config_get ai-fallback-models)
    if [ -n "$AI_FALLBACK" ]; then
        echo ""
        echo "fallback:"
        IFS=',' read -ra FB_MODELS <<< "$AI_FALLBACK"
        for fb in "${FB_MODELS[@]}"; do
            fb=$(echo "$fb" | xargs)  # trim
            fb_provider=$(echo "$fb" | cut -d'/' -f1)
            fb_model=$(echo "$fb" | cut -d'/' -f2-)
            if [ -n "$fb_provider" ] && [ -n "$fb_model" ]; then
                echo "  - provider: ${fb_provider}"
                echo "    model: ${fb_model}"
            fi
        done
    fi

    # Custom endpoint (ai-base-url for primary)
    if [ -n "$AI_BASE_URL" ]; then
        echo ""
        echo "providers:"
        echo "  custom:"
        echo "    base_url: ${AI_BASE_URL}"
    fi

    # Dashboard basic auth
    if [ -n "$DASHBOARD_USERNAME" ] && [ -n "$DASHBOARD_PASSWORD" ]; then
        # Use stdlib scrypt (same algorithm hermes uses) — no third-party deps needed.
        # Falls back to writing plaintext 'password:' which hermes hashes in-memory on startup.
        PASSWORD_HASH=$(python3 -c "
import sys, hashlib, secrets, base64
pw = sys.argv[1]
salt = secrets.token_bytes(16)
dk = hashlib.scrypt(pw.encode('utf-8'), salt=salt, n=2**14, r=8, p=1, dklen=32, maxmem=0)
print('scrypt\$16384\$8\$1\$' + base64.b64encode(salt).decode() + '\$' + base64.b64encode(dk).decode())
" "$DASHBOARD_PASSWORD" 2>/dev/null || echo "")
        echo ""
        echo "dashboard:"
        echo "  basic_auth:"
        echo "    username: ${DASHBOARD_USERNAME}"
        if [ -n "$PASSWORD_HASH" ]; then
            echo "    password_hash: ${PASSWORD_HASH}"
        else
            # Fallback: hermes accepts plaintext 'password:' and hashes in-memory
            log "WARNING: scrypt hashing failed — writing plaintext password (hermes will hash on startup)"
            echo "    password: ${DASHBOARD_PASSWORD}"
        fi
    fi

} > "/tmp/hermes-config.yaml"

run_as_hermes_user "cp /tmp/hermes-config.yaml ${CONFIG_FILE}"
rm -f /tmp/hermes-config.yaml

# ---- Generate SOUL.md if provided ----
if [ -n "$SOUL_MD" ]; then
    log "Writing custom SOUL.md"
    echo "$SOUL_MD" > /tmp/hermes-soul.md
    run_as_hermes_user "cp /tmp/hermes-soul.md ${HERMES_DIR}/SOUL.md"
    rm -f /tmp/hermes-soul.md
fi

# ---- Generate .env ----
log "Generating .env"

ENV_FILE="${HERMES_DIR}/.env"

# Helper: map provider name to env var name
provider_env_var() {
    local provider="$1"
    case "$provider" in
        anthropic)      echo "ANTHROPIC_API_KEY" ;;
        openai)         echo "OPENAI_API_KEY" ;;
        google|gemini)  echo "GOOGLE_API_KEY" ;;
        copilot) echo "GITHUB_TOKEN" ;;
        openrouter)     echo "OPENROUTER_API_KEY" ;;
        xai)            echo "XAI_API_KEY" ;;
        groq)           echo "GROQ_API_KEY" ;;
        deepseek)       echo "DEEPSEEK_API_KEY" ;;
        mistral)        echo "MISTRAL_API_KEY" ;;
        nous)           echo "NOUS_API_KEY" ;;
        novita)         echo "NOVITA_API_KEY" ;;
        huggingface|hf) echo "HF_TOKEN" ;;
        alibaba)        echo "DASHSCOPE_API_KEY" ;;
        minimax)        echo "MINIMAX_API_KEY" ;;
        minimax-cn)     echo "MINIMAX_CN_API_KEY" ;;
        zai)            echo "GLM_API_KEY" ;;
        kimi|kimi-coding) echo "KIMI_API_KEY" ;;
        *)              echo "" ;;
    esac
}

{
    echo "# Managed by Juju charm — manual edits will be overwritten on config-changed"

    # Primary AI provider key
    if [ -n "$AI_API_KEY" ]; then
        PRIMARY_VAR=$(provider_env_var "$AI_PROVIDER")
        if [ -n "$PRIMARY_VAR" ]; then
            echo "${PRIMARY_VAR}=${AI_API_KEY}"
        else
            # Unknown provider — use generic
            echo "AI_API_KEY=${AI_API_KEY}"
        fi
    fi

    if [ -n "$AI_BASE_URL" ]; then
        echo "AI_BASE_URL=${AI_BASE_URL}"
    fi

    # Gateway access
    if [ "$ALLOW_ALL" = "true" ] || [ "$ALLOW_ALL" = "True" ]; then
        echo "GATEWAY_ALLOW_ALL_USERS=true"
    fi

    # Messaging tokens
    [ -n "$TELEGRAM_TOKEN" ] && echo "TELEGRAM_BOT_TOKEN=${TELEGRAM_TOKEN}"
    [ -n "$DISCORD_TOKEN" ] && echo "DISCORD_BOT_TOKEN=${DISCORD_TOKEN}"
    [ -n "$SLACK_BOT_TOKEN" ] && echo "SLACK_BOT_TOKEN=${SLACK_BOT_TOKEN}"
    [ -n "$SLACK_APP_TOKEN" ] && echo "SLACK_APP_TOKEN=${SLACK_APP_TOKEN}"
    [ -n "$SIGNAL_PHONE" ] && echo "SIGNAL_PHONE_NUMBER=${SIGNAL_PHONE}"
    [ -n "$LINE_TOKEN" ] && echo "LINE_CHANNEL_ACCESS_TOKEN=${LINE_TOKEN}"
    [ -n "$LINE_SECRET" ] && echo "LINE_CHANNEL_SECRET=${LINE_SECRET}"

    # Home Assistant
    [ -n "$HA_URL" ] && echo "HOME_ASSISTANT_URL=${HA_URL}"
    [ -n "$HA_TOKEN" ] && echo "HOME_ASSISTANT_TOKEN=${HA_TOKEN}"

    # Matrix
    [ -n "$MATRIX_HOMESERVER" ] && echo "MATRIX_HOMESERVER=${MATRIX_HOMESERVER}"
    [ -n "$MATRIX_USER_ID" ] && echo "MATRIX_USER_ID=${MATRIX_USER_ID}"
    [ -n "$MATRIX_TOKEN" ] && echo "MATRIX_ACCESS_TOKEN=${MATRIX_TOKEN}"

    # Mattermost
    [ -n "$MATTERMOST_URL" ] && echo "MATTERMOST_URL=${MATTERMOST_URL}"
    [ -n "$MATTERMOST_TOKEN" ] && echo "MATTERMOST_TOKEN=${MATTERMOST_TOKEN}"

} > "/tmp/hermes-env"

run_as_hermes_user "cp /tmp/hermes-env ${ENV_FILE} && chmod 600 ${ENV_FILE}"
rm -f /tmp/hermes-env

# ---- Install extra packages (re-run on config-changed) ----
INSTALL_PKGS=$(config_get install-pkgs)
if [ -n "$INSTALL_PKGS" ]; then
    status_set maintenance "Installing extra packages"
    install_extra_pkgs "$INSTALL_PKGS"
fi

# ---- Ensure service is installed and manage lifecycle ----
if [ -z "$AI_PROVIDER" ] || [ -z "$AI_MODEL" ]; then
    status_set blocked "Missing AI provider or model configuration"
    exit 0
fi

if [ -z "$AI_API_KEY" ] && [ "$AI_PROVIDER" != "ollama" ]; then
    status_set blocked "Missing AI API key for provider: ${AI_PROVIDER}"
    exit 0
fi

# Always (re)write gateway systemd user unit to pick up ExecStart changes on upgrade
log "Writing Hermes Gateway systemd user service unit"

ensure_linger
ensure_hermes_dir

# Always (re)write gateway systemd user unit to pick up ExecStart changes on upgrade
log "Writing Hermes Gateway systemd user service unit"

ensure_linger
ensure_hermes_dir

cat > "/tmp/hermes-gateway.service" << UNITEOF
[Unit]
Description=Hermes Agent Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${HERMES_HOME}
Environment=HOME=${HERMES_HOME}
Environment=PATH=${HERMES_VENV}/bin:${HERMES_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/hermes gateway run --external-supervisor
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
UNITEOF

install -o "${HERMES_USER}" -g "${HERMES_USER}" -m 644 \
    /tmp/hermes-gateway.service "${HERMES_SYSTEMD_DIR}/${SERVICE_NAME}"
rm -f /tmp/hermes-gateway.service

systemctl_user daemon-reload
systemctl_user enable "$SERVICE_NAME"

# Restart or start the service
if is_service_active; then
    log "Restarting Hermes Gateway service"
    restart_service
else
    log "Starting Hermes Gateway service"
    start_service
fi

sleep 2

if ! is_service_active; then
    status_set blocked "Service failed to start — check: journalctl --user -u ${SERVICE_NAME}"
    exit 0
fi

# ---- Dashboard service ----
# Dashboard is enabled when both dashboard-username and dashboard-password are set.
# It always binds to 0.0.0.0 with basic auth.
DASHBOARD_PORT=$(config_get dashboard-port)

UNIT_IP=$(hostname -I | awk '{print $1}')

if [ -n "$DASHBOARD_USERNAME" ] && [ -n "$DASHBOARD_PASSWORD" ]; then
    DASH_UNIT_FILE="${HERMES_SYSTEMD_DIR}/${DASHBOARD_SERVICE_NAME}"
    log "Installing Hermes Dashboard user service (0.0.0.0:${DASHBOARD_PORT})"

    cat > "/tmp/hermes-dashboard.service" << DASHEOF
[Unit]
Description=Hermes Agent Dashboard
After=network-online.target hermes-gateway.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${HERMES_HOME}
Environment=HOME=${HERMES_HOME}
Environment=PATH=${HERMES_VENV}/bin:${HERMES_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/bin/hermes dashboard --port ${DASHBOARD_PORT} --host 0.0.0.0 --no-open --tui
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
DASHEOF

    install -o "${HERMES_USER}" -g "${HERMES_USER}" -m 644 \
        /tmp/hermes-dashboard.service "${DASH_UNIT_FILE}"
    rm -f /tmp/hermes-dashboard.service

    systemctl_user daemon-reload
    systemctl_user enable "$DASHBOARD_SERVICE_NAME"

    if systemctl_user is-active --quiet "$DASHBOARD_SERVICE_NAME" 2>/dev/null; then
        systemctl_user restart "$DASHBOARD_SERVICE_NAME"
    else
        systemctl_user start "$DASHBOARD_SERVICE_NAME"
    fi

    sleep 1
    DASH_URL="http://${UNIT_IP}:${DASHBOARD_PORT}"
    status_set active "Running (${AI_PROVIDER}/${AI_MODEL}) | Dashboard: ${DASH_URL}"
else
    # No credentials — stop dashboard if running
    if systemctl_user is-active --quiet "$DASHBOARD_SERVICE_NAME" 2>/dev/null; then
        log "dashboard-username/password not set — stopping dashboard"
        systemctl_user stop "$DASHBOARD_SERVICE_NAME"
    fi
    status_set active "Running (${AI_PROVIDER}/${AI_MODEL})"
fi
