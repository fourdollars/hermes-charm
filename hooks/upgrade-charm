#!/bin/bash
# upgrade-charm hook — update Hermes Agent if auto-update is enabled
# shellcheck disable=SC1091

source "$(dirname "$0")/common.sh"

# Resolve effective venv based on install method (mirrors config-changed)
_INSTALL_METHOD=$(config_get install-method)
if [ "$_INSTALL_METHOD" = "script" ] || [ -f "${HERMES_SCRIPT_VENV}/bin/hermes" ]; then
    HERMES_VENV="${HERMES_SCRIPT_VENV}"
fi

status_set maintenance "Upgrading charm"

# ---- Migrate from system-level to user-level services ----
# If the old system-level service units still exist, stop and remove them
# so the new user-level services can start cleanly.
if [ -f "/etc/systemd/system/${SERVICE_NAME}" ]; then
    log "Migrating from system-level to user-level systemd service"
    systemctl stop "$SERVICE_NAME" 2>/dev/null || true
    systemctl disable "$SERVICE_NAME" 2>/dev/null || true
    rm -f "/etc/systemd/system/${SERVICE_NAME}"
fi
if [ -f "/etc/systemd/system/${DASHBOARD_SERVICE_NAME}" ]; then
    systemctl stop "$DASHBOARD_SERVICE_NAME" 2>/dev/null || true
    systemctl disable "$DASHBOARD_SERVICE_NAME" 2>/dev/null || true
    rm -f "/etc/systemd/system/${DASHBOARD_SERVICE_NAME}"
fi
# Clean up any stale gateway PID file so hermes doesn't think it's already running
rm -f "${HERMES_DIR}/gateway.pid" 2>/dev/null || true
systemctl daemon-reload

AUTO_UPDATE=$(config_get auto-update)
INSTALL_METHOD=$(config_get install-method)
VERSION=$(config_get version)

# ---- Migrate pip install to script install ----
# If install-method is 'script' but the official installer layout doesn't exist yet
# (i.e. this unit was originally installed via pip), run the installer now.
# This handles charm upgrades on pre-existing pip-based deployments.
if [ "$INSTALL_METHOD" = "script" ] && [ ! -f "${HERMES_SCRIPT_VENV}/bin/hermes" ]; then
    log "Detected pip-based install but install-method=script — migrating to official installer"
    status_set maintenance "Migrating Hermes install to official installer"
    apt-get install -y -qq xz-utils 2>/dev/null || true
    run_as_hermes_user "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --skip-browser"
    # Update /usr/local/bin/hermes symlink to point at new install
    if [ -f "${HERMES_HOME}/.local/bin/hermes" ]; then
        ln -sf "${HERMES_HOME}/.local/bin/hermes" /usr/local/bin/hermes
        log "Migrated: /usr/local/bin/hermes → ${HERMES_HOME}/.local/bin/hermes"
    fi
fi

if [ "$AUTO_UPDATE" = "true" ] || [ "$AUTO_UPDATE" = "True" ]; then
    log "Auto-update enabled — updating Hermes Agent"
    status_set maintenance "Updating Hermes Agent"

    case "$INSTALL_METHOD" in
        script)
            # Use `hermes update` if available; otherwise re-run the official installer
            if run_as_hermes_user "command -v hermes" &>/dev/null; then
                run_as_hermes_user "hermes update" 2>/dev/null || \
                    run_as_hermes_user "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --skip-browser"
            else
                run_as_hermes_user "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --skip-browser"
            fi
            ;;
        pip)
            log "WARNING: pip install method is deprecated and no longer officially supported upstream."
            if [ "$VERSION" = "latest" ]; then
                run_as_hermes_user "${HERMES_VENV}/bin/pip install --upgrade hermes-agent"
            else
                run_as_hermes_user "${HERMES_VENV}/bin/pip install hermes-agent==${VERSION}"
            fi
            ;;
        git)
            HERMES_SRC="${HERMES_HOME}/.local/share/hermes-agent-src"
            if [ -d "$HERMES_SRC" ]; then
                run_as_hermes_user "cd ${HERMES_SRC} && git pull && uv sync"
            fi
            ;;
    esac

    log "Hermes Agent updated to: $(get_hermes_version)"
fi

# Re-run config-changed to regenerate config
"$(dirname "$0")/config-changed"

# Restart service
if is_service_active; then
    restart_service
fi

status_set active "Charm upgraded"
