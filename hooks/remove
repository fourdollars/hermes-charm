#!/bin/bash
# remove hook — clean up Hermes Agent installation
# shellcheck disable=SC1091

source "$(dirname "$0")/common.sh"

log "Removing Hermes Agent"

# Stop and disable gateway service
stop_service
if systemctl_user is-enabled --quiet "$SERVICE_NAME" 2>/dev/null; then
    systemctl_user disable "$SERVICE_NAME"
fi
run_as_hermes_user "rm -f '${HERMES_SYSTEMD_DIR}/${SERVICE_NAME}'"

# Stop and disable dashboard service
if systemctl_user is-active --quiet "$DASHBOARD_SERVICE_NAME" 2>/dev/null; then
    systemctl_user stop "$DASHBOARD_SERVICE_NAME"
fi
if systemctl_user is-enabled --quiet "$DASHBOARD_SERVICE_NAME" 2>/dev/null; then
    systemctl_user disable "$DASHBOARD_SERVICE_NAME"
fi
run_as_hermes_user "rm -f '${HERMES_SYSTEMD_DIR}/${DASHBOARD_SERVICE_NAME}'"

systemctl_user daemon-reload

log "Hermes Agent removed"
